---
/* The Sweety data model and the constraints that make an invalid reading impossible. */
---

<svg viewBox="0 0 720 344" role="img" aria-label="Sweety data model: users, readings, doctor assignments, reminders and reports">
  <text class="mini" x="16" y="16">TABLES</text>
  <text class="mini" x="556" y="16">JOBS &amp; READS</text>

  <!-- users -->
  <rect class="box" x="16" y="34" width="190" height="124" />
  <text class="head" x="28" y="52">users</text>
  <line class="hr" x1="16" y1="59" x2="206" y2="59" />
  <text class="field" x="28" y="75">id</text>
  <text class="field" x="28" y="90">name</text>
  <text class="field" x="28" y="105">email</text>
  <text class="field" x="28" y="120">password_hash</text>
  <text class="field" x="28" y="135">role</text>
  <text class="aside" x="196" y="120" text-anchor="end">bcrypt</text>

  <!-- doctor_patients -->
  <rect class="box" x="16" y="196" width="190" height="92" />
  <text class="head" x="28" y="214">doctor_patients</text>
  <line class="hr" x1="16" y1="221" x2="206" y2="221" />
  <text class="field" x="28" y="237">doctor_id</text>
  <text class="field" x="28" y="252">patient_id</text>
  <text class="aside" x="196" y="237" text-anchor="end">FK → users</text>

  <!-- readings -->
  <rect class="box box--core" x="272" y="88" width="228" height="160" />
  <text class="head" x="284" y="106">readings</text>
  <line class="hr" x1="272" y1="113" x2="500" y2="113" />
  <text class="field" x="284" y="129">id</text>
  <text class="field" x="284" y="144">user_id</text>
  <text class="field" x="284" y="159">reading_date</text>
  <text class="field" x="284" y="174">slot</text>
  <text class="field" x="284" y="189">value</text>
  <text class="aside" x="490" y="189" text-anchor="end">40–600</text>
  <text class="constraint" x="284" y="214">UNIQUE (user, date, slot)</text>
  <text class="constraint" x="284" y="227">CHECK value BETWEEN 40 AND 600</text>
  <text class="constraint" x="284" y="240">TRIGGER ≤ 4 readings / day</text>

  <!-- reminder_logs -->
  <rect class="box" x="556" y="34" width="148" height="118" />
  <text class="head" x="568" y="52">reminder_logs</text>
  <line class="hr" x1="556" y1="59" x2="704" y2="59" />
  <text class="field" x="568" y="75">user_id</text>
  <text class="field" x="568" y="90">log_date</text>
  <text class="field" x="568" y="105">reading_count</text>
  <text class="field" x="568" y="120">message</text>
  <text class="aside" x="568" y="141">BullMQ · 08:00</text>

  <!-- reports -->
  <rect class="box box--dash" x="556" y="196" width="148" height="92" />
  <text class="head" x="568" y="214">reports</text>
  <line class="hr" x1="556" y1="221" x2="704" y2="221" />
  <text class="field" x="568" y="237">daily</text>
  <text class="field" x="568" y="252">month-to-date</text>
  <text class="field" x="568" y="267">previous month</text>
  <text class="aside" x="568" y="281">derived, cached 300 s</text>

  <!-- relations -->
  <path class="wire" d="M206 96 H248 V128 H266" marker-end="url(#sw-ar)" />
  <text class="card" x="214" y="90">1 — many</text>
  <path class="wire" d="M111 158 V190" marker-end="url(#sw-ar)" />
  <path class="wire wire--dash" d="M500 170 H550" marker-end="url(#sw-ar)" />
  <path class="wire wire--dash" d="M500 100 C524 100 532 80 550 76" marker-end="url(#sw-ar)" />
  <text class="card" x="504" y="94">scan</text>

  <defs>
    <marker id="sw-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" fill="rgba(17,17,16,0.45)" />
    </marker>
  </defs>

  <line class="rule" x1="16" y1="310" x2="704" y2="310" />
  <text class="foot" x="16" y="326">Every rule is enforced twice: the service returns the assignment's message, and Postgres refuses the row if a request races another.</text>
  <text class="foot" x="16" y="339">Dates are calendar dates in UTC; the slot is the time context, because a reading has no clock time.</text>
</svg>

<style>
  .box {
    fill: rgba(17, 17, 16, 0.02);
    stroke: rgba(17, 17, 16, 0.3);
    stroke-width: 1;
  }

  .box--core {
    fill: rgba(217, 58, 31, 0.03);
    stroke: rgba(17, 17, 16, 0.45);
  }

  .box--dash {
    fill: none;
    stroke-dasharray: 4 4;
  }

  .head {
    font-family: var(--f-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    fill: #111110;
  }

  .field {
    font-family: var(--f-mono);
    font-size: 8.5px;
    fill: rgba(17, 17, 16, 0.6);
  }

  .aside {
    font-family: var(--f-mono);
    font-size: 7.5px;
    letter-spacing: 0.06em;
    fill: rgba(17, 17, 16, 0.38);
  }

  .constraint {
    font-family: var(--f-mono);
    font-size: 7.5px;
    letter-spacing: 0.04em;
    fill: #b3301a;
  }

  .hr {
    stroke: rgba(17, 17, 16, 0.2);
    stroke-width: 1;
  }

  .wire {
    fill: none;
    stroke: rgba(17, 17, 16, 0.38);
    stroke-width: 1;
  }

  .wire--dash {
    stroke-dasharray: 3 3;
  }

  .card {
    font-family: var(--f-mono);
    font-size: 7px;
    letter-spacing: 0.08em;
    fill: rgba(17, 17, 16, 0.4);
  }

  .mini {
    font-family: var(--f-mono);
    font-size: 8px;
    letter-spacing: 0.18em;
    fill: rgba(17, 17, 16, 0.42);
  }

  .rule {
    stroke: rgba(17, 17, 16, 0.16);
    stroke-width: 1;
  }

  .foot {
    font-family: var(--f-serif);
    font-size: 10.5px;
    font-style: italic;
    fill: rgba(17, 17, 16, 0.5);
  }
</style>
