---
import Field from './Field.astro';

const substrates = [
  ['rag', '01', 'Legal RAG'],
  ['llama', '02', 'Legal Llama'],
  ['qwen', '03', 'Abliteration'],
  ['tb', '04', 'TB-AMR'],
  ['transit', '05', 'Transit study'],
  ['sweety', '06', 'Sweety'],
  ['butterfly', '07', 'Butterfly'],
];
---

<section class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <div class="hero__meta">
        <span class="eyebrow">Portfolio — Vol. 01</span>
        <span class="eyebrow">Bengaluru, IN · <span id="clock">--:--</span> IST</span>
      </div>

      <h1 class="hero__name display">
        <span>Amarthya</span>
        <span class="hero__name-2">Thammappa Gari</span>
      </h1>

      <p class="abstract hero__thesis">
        I build machine learning systems for messy, high-stakes data — then make them explain themselves.
      </p>

      <p class="hero__range">
        {[
          'Legal retrieval',
          'TB genomics',
          'Transit economics',
          'Model alignment',
          'Clinical software',
        ].map((item) => <span>{item}</span>)}
      </p>

      <div class="hero__actions">
        <a class="btn btn--solid" href="#work">View the work <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn" href="/Amarthya_T_Resume_cr.pdf" download>Download CV <span aria-hidden="true">↓</span></a>
      </div>

      <p class="hero__foot">
        B.E. Computer Science (Data Science) · Acharya Institute of Technology · 2027
      </p>
    </div>

    <div class="hero__field">
      <Field />
    </div>
  </div>

  <div class="wrap">
    <div class="spectrum" role="tablist" aria-label="Substrates in the field">
      {substrates.map(([id, num, label], i) => (
        <button
          class="substrate"
          role="tab"
          data-topo={id}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="substrate__num">{num}</span>
          <span class="substrate__label">{label}</span>
        </button>
      ))}
    </div>
    <p class="spectrum__hint">Auto-cycling · hover to pause · select a substrate to hold it</p>
  </div>
</section>

<script>
  const clock = document.getElementById('clock');
  if (clock) {
    const tick = () => {
      const now = new Date();
      const time = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'Asia/Kolkata',
      }).format(now);
      clock.textContent = time;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .hero {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(40px, 6vw, 64px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(24px, 3.4vw, 52px);
    align-items: stretch;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .hero__name {
    margin-top: clamp(26px, 3.6vw, 46px);
    font-size: clamp(46px, 6.2vw, 86px);
    line-height: 0.86;
  }

  .hero__name-2 {
    display: block;
    margin-top: 0.14em;
    font-size: 0.53em;
    letter-spacing: -0.005em;
    line-height: 0.95;
  }

  .hero__thesis {
    margin-top: clamp(24px, 3vw, 36px);
    max-width: 34ch;
  }

  .hero__range {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 18px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Leading separator: it travels with the next item, so a wrap never
     leaves a slash stranded at the end of a line. */
  .hero__range span + span::before {
    content: '/';
    margin-right: 10px;
    color: var(--rule-mid);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: clamp(26px, 4vw, 44px);
  }

  .hero__foot {
    margin-top: 22px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .hero__field {
    display: flex;
    min-height: 100%;
  }

  /* ---------- spectrum ---------- */

  .spectrum {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    margin-top: clamp(30px, 4vw, 46px);
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .substrate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 13px 14px 15px;
    text-align: left;
    border-right: 1px solid var(--rule);
    transition: background var(--fast) var(--ease);
  }

  .substrate:last-child {
    border-right: 0;
  }

  .substrate:hover {
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .substrate[aria-selected='true'] {
    background: var(--paper-raise);
  }

  .substrate[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    background: var(--accent);
  }

  .substrate__num {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .substrate[aria-selected='true'] .substrate__num {
    color: var(--accent);
  }

  .substrate__label {
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .substrate[aria-selected='true'] .substrate__label {
    color: var(--ink);
  }

  .spectrum__hint {
    margin-top: 8px;
    text-align: right;
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .hero__meta {
      flex-direction: column;
      gap: 3px;
    }

    .hero__actions {
      padding-top: 26px;
    }

    .hero__thesis {
      max-width: none;
    }

    .spectrum {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .spectrum::-webkit-scrollbar {
      display: none;
    }

    .substrate {
      flex: 0 0 auto;
      min-width: 132px;
    }

    .spectrum__hint {
      text-align: left;
    }
  }
</style>
